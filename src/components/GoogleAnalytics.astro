---
/**
 * Google Analytics 4 com aviso de cookies (LGPD).
 * - Só é incluído quando SITE.googleAnalytics tem um ID (G-XXXXXXXXXX).
 * - O script do GA (gtag.js, ~100–150 KB) só é baixado depois do "Aceitar": quem recusa ou ignora
 *   o aviso não carrega nada do Google Analytics (página mais leve e nenhum dado enviado).
 *   O modo de consentimento continua declarado (analytics_storage) por segurança. A escolha fica
 *   salva no navegador e pode ser mudada pelo link "Preferências de cookies" no rodapé.
 * - Não altera os sinais de anúncios (AdSense continua como está).
 */
import { SITE } from '../config';
const id = SITE.googleAnalytics;
---

{
  id && (
    <>
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        var escolha = null;
        try {
          escolha = localStorage.getItem('consentimento-analytics');
        } catch (e) {}
        window.gtag('consent', 'default', {
          analytics_storage: escolha === 'aceito' ? 'granted' : 'denied',
          wait_for_update: 500,
        });
        // Baixa o gtag.js e começa a medir. Chamado na hora se a pessoa já aceitou antes, ou no
        // clique em "Aceitar". Os eventos disparados antes disso (ex.: inscrição na newsletter)
        // ficam na fila do dataLayer e só saem se o script for carregado.
        window.carregarAnalytics = function () {
          if (window.analyticsCarregado) return;
          window.analyticsCarregado = true;
          window.gtag('js', new Date());
          window.gtag('config', id);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
          document.head.appendChild(s);
        };
        if (escolha === 'aceito') window.carregarAnalytics();
      </script>

      <div id="aviso-cookies" class="aviso-cookies" role="region" aria-label="Aviso de cookies" hidden>
        <p>
          Usamos cookies do Google Analytics para entender como o site é lido e melhorar o conteúdo.
          Veja a <a href="/privacidade/">política de privacidade</a>.
        </p>
        <div class="aviso-cookies-botoes">
          <button type="button" data-consentimento="recusado">Recusar</button>
          <button type="button" data-consentimento="aceito" class="principal">Aceitar</button>
        </div>
      </div>

      <script is:inline>
        (function () {
          var aviso = document.getElementById('aviso-cookies');
          if (!aviso) return;
          var salvo = null;
          try {
            salvo = localStorage.getItem('consentimento-analytics');
          } catch (e) {}
          // Enquanto o aviso está aberto, a rolagem (inclusive a do foco pelo teclado) deixa um
          // espaço embaixo do tamanho dele, para que ele não cubra o elemento focado.
          var raiz = document.documentElement;
          var reservar = function () {
            var h = aviso.hidden ? 0 : aviso.offsetHeight + 32;
            raiz.style.scrollPaddingBottom = h ? h + 'px' : '';
            document.body.style.paddingBottom = h ? h + 'px' : '';
          };
          var mostrar = function () {
            aviso.hidden = false;
            reservar();
          };
          if (!salvo) mostrar();
          window.addEventListener('resize', reservar);
          aviso.addEventListener('click', function (ev) {
            var botao = ev.target.closest('button[data-consentimento]');
            if (!botao) return;
            var valor = botao.getAttribute('data-consentimento');
            try {
              localStorage.setItem('consentimento-analytics', valor);
            } catch (e) {}
            window.gtag('consent', 'update', { analytics_storage: valor === 'aceito' ? 'granted' : 'denied' });
            if (valor === 'aceito') window.carregarAnalytics();
            aviso.hidden = true;
            reservar();
          });
          document.addEventListener('click', function (ev) {
            if (ev.target.closest('[data-abrir-cookies]')) {
              ev.preventDefault();
              mostrar();
              var primeiro = aviso.querySelector('button');
              if (primeiro) primeiro.focus();
            }
          });
        })();
      </script>
    </>
  )
}
