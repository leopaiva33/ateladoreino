---
// Página para o link da bio do Instagram: os posts mais recentes (cada carrossel aponta
// para o seu artigo) e os atalhos do site. Atualiza sozinha a cada build (o blog é
// reconstruído todo dia na publicação agendada). Fora do Google: é só uma página de atalhos.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/posts';

const posts = (await getPublishedPosts()).slice(0, 8);
// Guia em destaque (isca da newsletter) enquanto fizer sentido; some sozinho depois da data.
const destaque =
  Date.now() < Date.parse('2026-12-12T23:59:00-03:00')
    ? { href: '/guias/hanuca/', texto: 'Guia grátis: Hanucá e Jesus em 8 noites (PDF)' }
    : null;
const utm = '?utm_source=instagram&utm_medium=bio';
const thumbOf = (image?: string) =>
  image ? image.replace(/\/([^/]+)\.\w+$/, '/thumbs/$1.webp') : undefined;
---

<BaseLayout
  title="Links"
  description="Os posts mais recentes da A Tela do Reino no Instagram, com o texto completo de cada um."
  noindex
>
  <section class="links">
    <h1>A Tela do Reino</h1>
    <p class="intro">Toque no post que você viu no Instagram para ler o texto completo.</p>

    {destaque && <a class="destaque" href={`${destaque.href}${utm}`}>{destaque.texto}</a>}

    <ul class="lista-links">
      {
        posts.map((post, i) => {
          const thumb = thumbOf(post.data.image);
          return (
            <li>
              <a href={`/blog/${post.id}/${utm}`}>
                {thumb && (
                  <img src={thumb} alt="" width="440" height="231" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                )}
                <span>{post.data.title}</span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <nav class="atalhos" aria-label="Mais da A Tela do Reino">
      <a href={`/blog/${utm}`}>Todos os artigos</a>
      <a href={`/estudos/${utm}`}>Estudos bíblicos</a>
      <a href={`/plano-de-leitura-tora/${utm}`}>Plano de leitura da Torá</a>
      <a href={`/newsletter/${utm}`}>Receber por e-mail</a>
      <a href="https://www.youtube.com/@atela_do_reino" rel="noopener" target="_blank">
        Vídeos no YouTube<span class="sr-only"> (abre em nova aba)</span>
      </a>
    </nav>
  </section>
</BaseLayout>

<style>
  .links {
    max-width: 34rem;
    margin: 0 auto;
    padding: 1.5rem 0 3rem;
  }
  h1 {
    margin-bottom: 0.25rem;
    text-align: center;
  }
  .intro {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .destaque {
    display: block;
    text-align: center;
    margin-bottom: 1rem;
    padding: 0.9rem 1rem;
    border-radius: var(--raio);
    border: 2px solid var(--cor-destaque);
    color: var(--cor-destaque);
    font-family: var(--fonte-interface);
    font-weight: 700;
    text-decoration: none;
  }
  .lista-links {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    gap: 0.75rem;
  }
  .lista-links a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.5rem;
    border: 1px solid var(--cor-borda-campo, currentColor);
    border-radius: var(--raio, 12px);
    text-decoration: none;
    color: inherit;
    font-weight: 600;
    line-height: 1.3;
    min-height: 48px;
  }
  .lista-links a:hover {
    text-decoration: underline;
  }
  .lista-links img {
    width: 6.5rem;
    height: auto;
    aspect-ratio: 440 / 231;
    object-fit: cover;
    border-radius: calc(var(--raio, 12px) - 4px);
    flex: none;
  }
  .atalhos {
    display: grid;
    gap: 0.6rem;
  }
  .atalhos a {
    display: block;
    text-align: center;
    padding: 0.8rem 1rem;
    border-radius: var(--raio-pilula, 999px);
    background: var(--cor-destaque, #7a1f2b);
    color: var(--cor-fundo, #fff);
    text-decoration: none;
    font-family: var(--fonte-interface, inherit);
    font-weight: 600;
    min-height: 48px;
  }
</style>
