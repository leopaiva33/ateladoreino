---
import { existsSync } from 'node:fs';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AutorBox from '../../components/AutorBox.astro';
import Compartilhar from '../../components/Compartilhar.astro';
import { SITE } from '../../config';
import { getPublishedEstudos, ehEstudoDePorcao } from '../../utils/estudos';
import { formatDate } from '../../utils/posts';
import { jsonLdArtigo } from '../../utils/jsonld';

export async function getStaticPaths() {
  const estudos = await getPublishedEstudos();
  // "Anterior" e "próximo" ficam dentro do mesmo tipo: porções entre si, temáticos entre si.
  return estudos.map((estudo) => {
    const grupo = estudos.filter((e) => ehEstudoDePorcao(e) === ehEstudoDePorcao(estudo));
    const i = grupo.indexOf(estudo);
    return { params: { slug: estudo.id }, props: { estudo, anterior: grupo[i - 1], proximo: grupo[i + 1] } };
  });
}

const { estudo, anterior, proximo } = Astro.props;
const { Content } = await render(estudo);
const { title, description, pubDate, updatedDate, parasha, significado, numero, livro, tema, leituras } =
  estudo.data;
const rotulo = (e: typeof estudo) => e.data.parasha ?? e.data.title;
const caminho = `/estudos/${estudo.id}/`;
const urlCompleta = new URL(caminho, SITE.url).href;
/** PDF gerado por `npm run pdf -- <slug>` em public/estudos/<slug>.pdf; sem arquivo, sem botão. */
const pdf = existsSync(`public/estudos/${estudo.id}.pdf`) ? `/estudos/${estudo.id}.pdf` : undefined;
const jsonLd = jsonLdArtigo({
  titulo: title,
  descricao: description,
  caminho,
  publicado: pubDate,
  atualizado: updatedDate,
});
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  jsonLd={jsonLd}
>
  <article class="artigo container">
    <header>
      <p class="meta">
        <span class="tag">{numero ? `Porção ${numero} · ${livro}` : `Estudo temático${tema ? ` · ${tema}` : ''}`}</span>
        Publicado em <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              {' · '}Atualizado em <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </>
          )
        }
      </p>
      <h1>{title}</h1>
      <p><em>{description}</em></p>
      {
        pdf && (
          <p class="baixar-pdf">
            <a class="btn-compartilhar" href={pdf} download={`${estudo.id}-a-tela-do-reino.pdf`}>
              Baixar o estudo em PDF
            </a>
          </p>
        )
      }
    </header>

    {
      leituras.length > 0 && (
        <section class="leituras" aria-labelledby="leituras-titulo">
          <h2 id="leituras-titulo">
            {parasha ? `Leituras da porção ${parasha}` : 'Textos-base'}
            {significado && ` (${significado})`}
          </h2>
          <ul>
            {leituras.map((l) => (
              <li>
                <span class="leituras-rotulo">{l.rotulo}</span>
                <strong>{l.texto}</strong>
                {l.tema && <span class="leituras-tema">{l.tema}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="corpo">
      <Content />
    </div>

    {
      pdf && (
        <p class="baixar-pdf">
          <a class="btn-compartilhar" href={pdf} download={`${estudo.id}-a-tela-do-reino.pdf`}>
            Baixar o estudo em PDF
          </a>
        </p>
      )
    }

    <Compartilhar url={urlCompleta} titulo={title} />

    <AutorBox />

    <p class="meta navegacao-estudos">
      {anterior && <a href={`/estudos/${anterior.id}`}>← {rotulo(anterior)}</a>}
      {anterior && proximo && ' · '}
      {proximo && <a href={`/estudos/${proximo.id}`}>{rotulo(proximo)} →</a>}
    </p>
    <p class="navegacao-estudos"><a href="/estudos">← Voltar para todos os estudos</a></p>
  </article>
</BaseLayout>
